{
	"name": "claude-skills-manager",
	"displayName": "Claude Skills Manager",
	"description": "Browse, inspect, and toggle Claude agents, skills, and config files from your project and global ~/.claude folders",
	"version": "0.1.0",
	"publisher": "arvis-iljins",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "claude-skills",
					"title": "Claude Skills",
					"icon": "./assets/icon.svg"
				}
			]
		},
		"views": {
			"claude-skills": [
				{
					"id": "claude-skills-tree",
					"name": "Skills Manager"
				}
			]
		},
		"commands": [
			{
				"command": "claude-skills.refresh",
				"title": "Claude Skills: Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "claude-skills.disableSkill",
				"title": "Disable",
				"icon": "$(circle-slash)"
			},
			{
				"command": "claude-skills.enableSkill",
				"title": "Enable",
				"icon": "$(pass)"
			},
			{
				"command": "claude-skills.openFile",
				"title": "Open File",
				"icon": "$(go-to-file)"
			},
			{
				"command": "claude-skills.disableAll",
				"title": "Disable All Skills",
				"icon": "$(circle-slash)"
			},
			{
				"command": "claude-skills.enableAll",
				"title": "Enable All Skills",
				"icon": "$(pass)"
			},
			{
				"command": "claude-skills.setFilter",
				"title": "Filter Skills",
				"icon": "$(search)"
			},
			{
				"command": "claude-skills.clearFilter",
				"title": "Clear Filter",
				"icon": "$(clear-all)"
			},
			{
				"command": "claude-skills.clearActivity",
				"title": "Clear Session Activity",
				"icon": "$(trash)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "claude-skills.refresh",
					"when": "view == claude-skills-tree",
					"group": "navigation@3"
				},
				{
					"command": "claude-skills.enableAll",
					"when": "view == claude-skills-tree",
					"group": "navigation@2"
				},
				{
					"command": "claude-skills.disableAll",
					"when": "view == claude-skills-tree",
					"group": "navigation@1"
				},
				{
					"command": "claude-skills.setFilter",
					"when": "view == claude-skills-tree",
					"group": "navigation@4"
				},
				{
					"command": "claude-skills.clearFilter",
					"when": "view == claude-skills-tree",
					"group": "navigation@5"
				},
				{
					"command": "claude-skills.clearActivity",
					"when": "view == claude-skills-tree",
					"group": "navigation@6"
				}
			],
			"view/item/context": [
				{
					"command": "claude-skills.disableSkill",
					"when": "view == claude-skills-tree && viewItem == skill-enabled",
					"group": "inline@1"
				},
				{
					"command": "claude-skills.enableSkill",
					"when": "view == claude-skills-tree && viewItem == skill-disabled",
					"group": "inline@1"
				},
				{
					"command": "claude-skills.openFile",
					"when": "view == claude-skills-tree && viewItem =~ /^skill-/",
					"group": "inline@2"
				},
				{
					"command": "claude-skills.disableSkill",
					"when": "view == claude-skills-tree && viewItem == skill-enabled",
					"group": "1_actions"
				},
				{
					"command": "claude-skills.enableSkill",
					"when": "view == claude-skills-tree && viewItem == skill-disabled",
					"group": "1_actions"
				},
				{
					"command": "claude-skills.openFile",
					"when": "view == claude-skills-tree && viewItem =~ /^skill-/",
					"group": "2_open"
				}
			]
		}
	},
	"__metadata": {
		"installedTimestamp": 1793781792838,
		"targetPlatform": "undefined",
		"size": 30594
	}
}